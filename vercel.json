{
  "cleanUrls": true,
  "redirects": [
    { "source": "/pavimentos", "destination": "/loja", "permanent": true },
    { "source": "/construção", "destination": "/construcao", "permanent": true },
    { "source": "/empreiteiros", "destination": "/construcao", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt|loja|vinilico|flutuante|rodapes|cozinha|construcao|contactos|encomenda|politica-de-privacidade).*)", "destination": "/index.html" }
  ]
}
