{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.carpimater.pt" }],
      "destination": "https://carpimater.pt/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.carpimater.pt" }],
      "destination": "https://carpimater.pt/:path*",
      "permanent": true
    },
    { "source": "/pavimentos", "destination": "/loja", "permanent": true },
    { "source": "/construção", "destination": "/construcao", "permanent": true },
    { "source": "/empreiteiros", "destination": "/construcao", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt|loja|vinilico|flutuante|rodapes|cozinha|construcao|contactos|encomenda|politica-de-privacidade|termos-e-condicoes|montagem-cozinhas-coimbra|roupeiros-por-medida-coimbra|instalacao-rodapes-coimbra).*)", "destination": "/index.html" }
  ]
}
